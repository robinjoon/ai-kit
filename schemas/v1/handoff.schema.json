{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ctx:schema:v1:handoff",
  "title": "ctx handoff pointer v1",
  "description": "The thin front matter record of a derived handoff document.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "handoff_id",
    "task_id",
    "checkpoint_id",
    "checkpoint_digest",
    "generated_at",
    "producer",
    "render_profile",
    "rendered_body_digest",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/schemaVersion"
    },
    "record_type": {
      "const": "ctx.handoff"
    },
    "handoff_id": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/ulid"
    },
    "task_id": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/ulid"
    },
    "checkpoint_id": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/ulid"
    },
    "checkpoint_digest": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/sha256Digest"
    },
    "generated_at": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/timestamp"
    },
    "producer": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/producer"
    },
    "target": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/agentTarget"
    },
    "render_profile": {
      "const": "ctx-handoff-markdown-v1"
    },
    "rendered_body_digest": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/sha256Digest"
    },
    "extensions": {
      "$ref": "urn:ctx:schema:v1:common#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
